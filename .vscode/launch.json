{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🧠 Launch Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/dashboard/streamlit_app.py",
                "--server.port=8501"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🚀 Run Full ML Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/MindGraphNet_Enhanced_Pipeline.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⚡ Start FastAPI Microservice",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "api.app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧪 Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "tests/test_pipeline.py"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
